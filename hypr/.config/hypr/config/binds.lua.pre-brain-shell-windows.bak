------------------------------------------------------------------------
-- KEYBINDINGS
-- ランチャー/バーは使わない。terminal=kitty, tmuxで完結させる。
------------------------------------------------------------------------

-- Core commands
hl.bind("SUPER + RETURN", hl.dsp.exec_cmd("kitty"))

-- window overview (Mission Control風、endfield-shell)
-- hl.bind("SUPER + TAB", hl.dsp.exec_cmd("qs -c endfield-shell ipc call windowoverview toggle"))
hl.bind("SUPER + TAB", hl.plugin.gloview.toggle)
hl.bind("SUPER + SHIFT + TAB", hl.plugin.gloview.desktop)
hl.bind("SUPER + CTRL + TAB", hl.plugin.gloview.allworkspaces)

-- hypr-info: ライブダッシュボード
hl.bind(
	"SUPER + I",
	hl.dsp.exec_cmd(
		"kitty"
			.. " --class=hypr-info"
			.. " --override initial_window_width=900"
			.. " --override initial_window_height=600"
			.. " --override remember_window_size=no"
			.. " -- /home/kuroiko/Documents/hypr/hypr-info"
	)
)

-- endfield-shell: アプリケーションランチャー

hl.bind("SUPER + SHIFT + RETURN", hl.dsp.exec_cmd("kitty tmux new-session -A -s main"))
hl.bind("SUPER + E", hl.dsp.exec_cmd("nautilus"))
-- hl.bind("SUPER + R", hl.dsp.exec_cmd("fuzzel"))
hl.bind("SUPER + W", hl.dsp.exec_cmd("zen-browser || firefox"))
hl.bind("SUPER + Q", hl.dsp.window.close())
-- endfield-shell: クリップボード履歴
hl.bind("SUPER + V", hl.dsp.exec_cmd("qs -c endfield-shell ipc call clipboard toggle"))
-- hl.bind("SUPER + ESCAPE", hl.dsp.exec_cmd("qs -c endfield-shell ipc call powermenu toggle"))
hl.bind("SUPER + CTRL + SHIFT + L", hl.dsp.exec_cmd("qs -c endfield-shell ipc call lock lock"))
-- hl.bind("SUPER + M", hl.dsp.exec_cmd("hyprctl dispatch exit"))

hl.bind("SUPER + CTRL + mouse_down", hl.dsp.layout("cyclenext"))
hl.bind("SUPER + CTRL + mouse_up", hl.dsp.layout("cyclenext prev"))

hl.bind("SUPER + H", hl.dsp.layout("focus l"))
hl.bind("SUPER + L", hl.dsp.layout("focus r"))
hl.bind("SUPER + K", hl.dsp.layout("focus u"))
hl.bind("SUPER + J", hl.dsp.layout("focus d"))

hl.bind("SUPER + SHIFT + H", hl.dsp.layout("movewindowto l"))
hl.bind("SUPER + SHIFT + L", hl.dsp.layout("movewindowto r"))
hl.bind("SUPER + SHIFT + K", hl.dsp.layout("movewindowto u"))
hl.bind("SUPER + SHIFT + J", hl.dsp.layout("movewindowto d"))

hl.bind("SUPER + ALT + H", hl.dsp.layout("swapcol l"))
hl.bind("SUPER + ALT + L", hl.dsp.layout("swapcol r"))

hl.bind("SUPER + asciicircum", hl.dsp.layout("colresize +0.05"))
hl.bind("SUPER + minus", hl.dsp.layout("colresize -0.05"))

hl.bind("SUPER + bracketright", hl.dsp.layout("colresize +conf"))
hl.bind("SUPER + bracketleft", hl.dsp.layout("colresize -conf"))

hl.bind("SUPER + SHIFT + minus", hl.dsp.layout("colresize all 0.5"))

hl.bind("SUPER + period", hl.dsp.layout("move +col"))
hl.bind("SUPER + comma", hl.dsp.layout("move -col"))

hl.bind("SUPER + SHIFT + period", hl.dsp.layout("move +200"))
hl.bind("SUPER + SHIFT + comma", hl.dsp.layout("move -200"))

hl.bind("SUPER + P", hl.dsp.layout("promote"))

hl.bind("SUPER + F", hl.dsp.layout("fit active"))
hl.bind("SUPER + SHIFT + F", hl.dsp.layout("fit visible"))
hl.bind("SUPER + CTRL + F", hl.dsp.layout("fit all"))
hl.bind("SUPER + T", hl.dsp.layout("togglefit"))

hl.bind("SUPER + CTRL + bracketleft", hl.dsp.layout("pin left"))
hl.bind("SUPER + CTRL + bracketright", hl.dsp.layout("pin right"))
hl.bind("SUPER + CTRL + backslash", hl.dsp.layout("unpin"))

hl.bind("SUPER + ALT + F", hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" }))
hl.bind("SUPER + ALT + SPACE", hl.dsp.window.float({ action = "toggle" }))
hl.bind("SUPER + J", hl.dsp.layout("togglesplit")) -- dwindle only

-- Focus movement — hypr-nav 経由でシームレスナビ
-- kitty + tmux なら: tmux ペイン端でない → tmux select-pane
--                    tmux ペイン端        → Hyprland movefocus
-- kitty 以外なら:   常に Hyprland movefocus
local NAV = "/home/kuroiko/Documents/hypr/hypr-nav "
hl.bind("SUPER + left", hl.dsp.exec_cmd(NAV .. "left"))
hl.bind("SUPER + right", hl.dsp.exec_cmd(NAV .. "right"))
hl.bind("SUPER + up", hl.dsp.exec_cmd(NAV .. "up"))
hl.bind("SUPER + down", hl.dsp.exec_cmd(NAV .. "down"))

-- Window movement
hl.bind("SUPER + SHIFT + left", hl.dsp.window.move({ direction = "left" }))
hl.bind("SUPER + SHIFT + right", hl.dsp.window.move({ direction = "right" }))
hl.bind("SUPER + SHIFT + up", hl.dsp.window.move({ direction = "up" }))
hl.bind("SUPER + SHIFT + down", hl.dsp.window.move({ direction = "down" }))

-- Workspace switch / send window (1-10)
for i = 1, 10 do
	local key = i % 10 -- 10 は 0キーに割り当て
	hl.bind("SUPER + " .. key, hl.dsp.focus({ workspace = i }))
	hl.bind("SUPER + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }))
end

for i = 1, 5 do
	hl.bind("SUPER + CTRL + SHIFT + " .. i, hl.dsp.layout("movecoltoworkspace " .. i))
end

-- Move column to relative workspace or special scratchpad
hl.bind("SUPER + CTRL + SHIFT + right", hl.dsp.layout("movecoltoworkspace +1"))
hl.bind("SUPER + CTRL + SHIFT + left", hl.dsp.layout("movecoltoworkspace -1"))
hl.bind("SUPER + CTRL + SHIFT + S", hl.dsp.layout("movecoltoworkspace special"))

-- Scratchpad
hl.bind("SUPER + S", hl.dsp.workspace.toggle_special("magic"))
hl.bind("SUPER + SHIFT + S", hl.dsp.window.move({ workspace = "special:magic" }))

hl.bind("SUPER + C", hl.dsp.layout("togglecollapse"))

hl.bind("SUPER + Z", hl.dsp.layout("zen"))

hl.bind("SUPER + ALT + bracketleft", hl.dsp.layout("focusback"))
hl.bind("SUPER + ALT + bracketright", hl.dsp.layout("focusfwd"))

-- Scroll through workspaces
hl.bind("SUPER + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind("SUPER + mouse_up", hl.dsp.focus({ workspace = "e-1" }))

-- Move/resize with mouse
hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true })
hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Media / hardware keys
hl.bind(
	"XF86AudioRaiseVolume",
	hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"),
	{ locked = true, repeating = true }
)
hl.bind(
	"XF86AudioLowerVolume",
	hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),
	{ locked = true, repeating = true }
)
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), { locked = true })
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), { locked = true })
hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("brightnessctl set 5%+"), { locked = true, repeating = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl set 5%-"), { locked = true, repeating = true })
hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl next"), { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl previous"), { locked = true })

-- Screenshot (hyprshot + swappy) — 全部クリップボードへ
hl.bind("PRINT", hl.dsp.exec_cmd("hyprshot -m output --clipboard-only"))
hl.bind("CTRL + PRINT", hl.dsp.exec_cmd("hyprshot -m window --clipboard-only"))
hl.bind("SHIFT + PRINT", hl.dsp.exec_cmd("sh -c 'hyprshot -m region --raw | swappy -f - -o - | wl-copy'"))
